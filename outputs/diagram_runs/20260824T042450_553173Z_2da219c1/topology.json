    {
      "op_id": "mixer_1",
      "op_type": "mixer",
      "label": "T-mixer (mixer_h2_t, stainless steel, 4.35 mm ID, 40 bar) placed immediately before the packed-bed inlet",
      "parameters": {
        "type": "T-mixer (mixer_h2_t, stainless steel, 4.35 mm ID, 40 bar) placed immediately before the packed-bed inlet",
        "material": "not specified",
        "inventory_assignment_status": "unresolved",
        "unresolved_inventory_category": "mixers"
      },
      "required": true,
      "rationale": "From Chemistry Plan: (1) start pump_h2_pilot and establish steady liquid flow of the N2-sparged DMAOL/MeOH feed; (2) only then open mfc_h2_100 so H2 joins at mixer_h2_t through safety_h2_check_valve - the check valve prevents gas backflow into the pump head (vapour lock). The T sits directly at the bed inlet so segmented gas-liquid structure is generated with minimal upstream holdup and interfacial renewal occurs inside the catalyst bed. Flow through reactor_h2_pbr_300 is downflow (trickle) for stable liquid distribution and no fines fluidisation. Downstream: bed -> bath exit -> bpr_h2_21 -> separator_h2_gl (safety_h2_vent) -> collector_h2_250. Catalyst is a fixed bed, never in a feed stream.",
      "inventory_item_id": null,
      "inventory_item_ids": [],
      "instrument_name": "",
      "inventory_category": "mixers",
      "assignment_status": "unresolved",
      "capability_checks": {}
    },
